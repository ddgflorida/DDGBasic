REM BEGIN / END TRANSACTION / COMMIT / ROLLBACK as line-level SQL, on both engines.
REM Any failed check raises an error (exit 1).
DATABASE OPEN ":memory:"
CREATE TABLE t (a INTEGER);
BEGIN TRANSACTION;
INSERT INTO t VALUES (1);
END TRANSACTION;
BEGIN TRANSACTION;
INSERT INTO t VALUES (2);
ROLLBACK;
BEGIN;
INSERT INTO t VALUES (3);
COMMIT;
n = (SELECT COUNT(*) FROM t)
IF n <> 2 THEN ERROR 1, "SQLite: expected 2 rows, got " + STR$(n)

DATABASE ENGINE DUCKDB
CREATE TABLE d (a INTEGER);
BEGIN TRANSACTION;
INSERT INTO d VALUES (1);
END TRANSACTION;
EXECUTE "BEGIN TRANSACTION; INSERT INTO d VALUES (2); END TRANSACTION"
n = (SELECT COUNT(*) FROM d)
IF n <> 2 THEN ERROR 1, "DuckDB: expected 2 rows, got " + STR$(n)

PRINT "transactions: all checks passed"
