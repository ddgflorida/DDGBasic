{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DDGBasic",
  "scopeName": "source.ddgbasic",
  "comment": "Generated by tools/gen_vscode.py from src/ddgbasic.py. Do not edit by hand.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#label"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#phrases"
    },
    {
      "include": "#statement-words"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#sql"
    },
    {
      "include": "#bind"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.rem.ddgbasic",
          "match": "(?i)(?<![\\w$])REM(?![\\w$]).*$"
        },
        {
          "name": "comment.line.double-dash.ddgbasic",
          "match": "--.*$"
        },
        {
          "name": "comment.block.ddgbasic",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ddgbasic",
          "begin": "\"",
          "end": "\"(?!\")",
          "patterns": [
            {
              "name": "constant.character.escape.ddgbasic",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "string.quoted.single.sql.ddgbasic",
          "match": "'[^'\\n]*'"
        },
        {
          "name": "string.interpolated.ddgbasic",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "meta.interpolation.ddgbasic",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.ddgbasic"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.ddgbasic"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "label": {
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)(:)(?!=)\\s*(?=$|REM\\b|--)",
      "captures": {
        "1": {
          "name": "entity.name.label.ddgbasic"
        },
        "2": {
          "name": "punctuation.separator.label.ddgbasic"
        }
      }
    },
    "numbers": {
      "name": "constant.numeric.ddgbasic",
      "match": "(?<![\\w$.])(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?(?![\\w$])"
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.ddgbasic",
          "match": "(?i)(?<![\\w$])(?:JSON_SERIALIZE\\$|URL_FILENAME\\$|URL_HOSTNAME\\$|WEEKDAYNAME\\$|FORMATDATE\\$|HTMLDECODE\\$|HTMLENCODE\\$|URL_SCHEME\\$|MONTHNAME\\$|STRIPHTML\\$|URLDECODE\\$|URLENCODE\\$|BASENAME\\$|CARDINAL\\$|MONTHCAL\\$|PADRIGHT\\$|PATHNAME\\$|TYPENAME\\$|URL_PATH\\$|COMMAND\\$|ENVIRON\\$|EXTRACT\\$|LASTKEY\\$|MENUBAR\\$|ORDINAL\\$|PADLEFT\\$|REPLACE\\$|REVERSE\\$|SOUNDEX\\$|YEARCAL\\$|BUTTON\\$|CENTER\\$|CURDIR\\$|FORMAT\\$|PROPER\\$|REPEAT\\$|INKEY\\$|LCASE\\$|LTRIM\\$|RIGHT\\$|RTRIM\\$|SPACE\\$|UCASE\\$|DATE\\$|LEFT\\$|TIME\\$|TRIM\\$|CHR\\$|HEX\\$|MID\\$|OCT\\$|STR\\$|QR\\$)(?![\\w$])"
        },
        {
          "name": "support.function.builtin.ddgbasic",
          "match": "(?i)(?<![\\w$])(?:DAYSINMONTH|FILE_EXISTS|HASH_DELETE|HASH_EXISTS|HASH_RENAME|HASH_VALUES|ARRAY_JOIN|ARRAY_SIZE|DATESERIAL|DAYSINYEAR|HASH_COUNT|SAVESCREEN|STARTSWITH|DISKSPACE|HASH_JOIN|HASH_KEYS|ISNUMERIC|PARSEJSON|CONTAINS|DATEDIFF|ENDSWITH|FILEATTR|FILESIZE|FILETIME|FREEFILE|INSTRREV|IS_ARRAY|MOUSECOL|MOUSEROW|DATEADD|DEGREES|ISALNUM|ISALPHA|ISDIGIT|IS_HASH|RADIANS|WEEKDAY|FILTER|ISDATE|ISLEAP|MINUTE|REDUCE|SECOND|UBOUND|ALERT|ARRAY|ATAN2|FLOOR|INSTR|MONTH|POWER|ROUND|SPLIT|TIMER|CEIL|FIND|HOUR|MENU|YEAR|ABS|ASC|ATN|COS|DAY|EOF|EXP|FIX|INT|LEN|LOG|MAP|MAX|MIN|MOD|NOW|NVL|RND|SGN|SIN|SQR|TAN|VAL)(?!\\$)(?![\\w$])(?=\\s*\\()"
        }
      ]
    },
    "phrases": {
      "patterns": [
        {
          "match": "(?i)(?<![\\w$])(ANALYZE)\\s+(TEXT)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(FOR)\\s+(EACH)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(IN)\\s+(TEXT)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(LINE)\\s+(INPUT)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(LOAD)\\s+(TEXT)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(MAKE)\\s+(FORM)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(MAKE)\\s+(REPORT)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(ON)\\s+(KEY)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(READ)\\s+(FILE)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(SET)\\s+(EMAIL)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(SET)\\s+(STYLE)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(SET)\\s+(THEME)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(SHOW)\\s+(INDEXES)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(SHOW)\\s+(TABLES)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(SHOW)\\s+(VARIABLES)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(TRANSFORM)\\s+(ROW)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(USING)\\s+(KEY)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(USING)\\s+(SCHEMA)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(VALIDATE)\\s+(ROW)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w$])(WITH)\\s+(HEADERS)(?![\\w$])",
          "captures": {
            "1": {
              "name": "keyword.control.ddgbasic"
            },
            "2": {
              "name": "keyword.control.ddgbasic"
            }
          }
        }
      ]
    },
    "statement-words": {
      "match": "(?i)(?:^|(?<=:))\\s*(VARIABLES|CHECKBOX|PRESERVE|REQUIRED|CONFIRM|DETAILS|HEADERS|INDEXES|MESSAGE|BUTTON|CANCEL|DETAIL|FIELDS|FORMAT|LOOKUP|REPORT|SCHEMA|SHADOW|TABLES|EMAIL|MOUSE|PATCH|STYLE|THEME|EACH|EDIT|FILE|HINT|LINE|LIST|NAME|READ|SAVE|TEXT|VIEW|ALL|KEY|OFF|PUT|ROW|SQL)(?![\\w$])(?!\\s*(?:=|\\.|\\(|\\[))",
      "captures": {
        "1": {
          "name": "keyword.control.ddgbasic"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.operator.word.ddgbasic",
          "match": "(?i)(?<![\\w$])(?:AND|OR|NOT|MOD)(?![\\w$])"
        },
        {
          "name": "keyword.control.ddgbasic",
          "match": "(?i)(?<![\\w$])(?:SQL_FATAL_ERRORS|WITHFOLDERSONLY|ENDTRANSACTION|NULL_HANDLING|PRESERVE_CASE|WITHFILESONLY|WITHFULLPATH|ANALYZEJSON|ANALYZETEXT|AUTOADVANCE|ENDFUNCTION|IGNORE_CASE|ONERRORGOTO|TRANSACTION|WITHDETAILS|ANALYZECSV|RESTSCREEN|LINEINPUT|SUMMARIZE|TRANSFORM|DATABASE|DESCRIBE|FUNCTION|PROGRESS|READFILE|ROLLBACK|TRUNCATE|VALIDATE|ANALYZE|BROWSER|ENDLOOP|EXECUTE|FOREACH|OPTIONS|PARQUET|PICTURE|REJECTS|REPLACE|REVERSE|UNSHIFT|UPGRADE|APPEND|ATTACH|BROWSE|COMMIT|CREATE|DELETE|ELSEIF|ENGINE|EXISTS|IGNORE|INSERT|LOCATE|OUTPUT|PRAGMA|RESUME|RETURN|SELECT|SPLICE|TOFILE|UNPACK|UPDATE|UPSERT|ALTER|BEGIN|CHAIN|CHDIR|CLEAR|CLOSE|COLOR|ENDIF|ERROR|EXCEL|FETCH|FILES|FIXED|GOSUB|INPUT|JSONL|MERGE|MKDIR|PLAIN|PRINT|REDIM|RMDIR|SHELL|SHIFT|TABLE|TROFF|UNTIL|UNZIP|USING|VALID|WHILE|WRITE|BELL|COPY|DROP|DUMP|ECHO|ELSE|EVAL|EXIT|FORM|FROM|GOTO|HASH|HELP|HTML|INTO|JSON|KILL|LOAD|LOOP|MAKE|NEXT|OPEN|POST|PUSH|SHOW|SORT|STEP|THEN|TRON|WEND|WHEN|WITH|BOX|CLS|CSV|DIM|END|FOR|GET|LET|POP|RUN|SAY|SET|XML|ZIP|AS|DO|IF|IN|ON|QR|TO)(?!\\$)(?![\\w$])"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.ddgbasic",
      "match": "<>|<=|>=|[=<>+\\-*/^&]"
    },
    "sql": {
      "name": "keyword.other.sql.ddgbasic",
      "match": "(?i)(?<![\\w$])(?:REFERENCES|COALESCE|DISTINCT|BETWEEN|DEFAULT|INTEGER|NUMERIC|PRIMARY|TRIGGER|VARCHAR|HAVING|OFFSET|UNIQUE|VALUES|CHECK|COUNT|GROUP|INDEX|INNER|LIMIT|ORDER|OUTER|RIGHT|UNION|WHERE|BLOB|CASE|DATE|DESC|JOIN|LEFT|LIKE|NULL|REAL|TEXT|VIEW|AND|AVG|KEY|NOT|SUM|BY|IS|OR)(?!\\$)(?![\\w$])"
    },
    "bind": {
      "name": "variable.parameter.bind.ddgbasic",
      "match": "(?<![\\w:]):[A-Za-z_][A-Za-z0-9_]*"
    },
    "variables": {
      "name": "variable.other.ddgbasic",
      "match": "(?<![\\w$])[A-Za-z_][A-Za-z0-9_]*\\$?"
    }
  }
}
